# All values here are public and embedded at build time. Never put secrets here.
# Optional identity/profile values use the verified defaults in src/config/site.ts.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Project destinations are environment-only. Blank values show disabled actions.
# Leave unavailable links blank. Do not use example URLs in production.
NEXT_PUBLIC_HALO_REPOSITORY_URL=
NEXT_PUBLIC_HALO_LIVE_URL=
NEXT_PUBLIC_KAUSHALIQ_REPOSITORY_URL=
NEXT_PUBLIC_KAUSHALIQ_LIVE_URL=
NEXT_PUBLIC_GEOVISTA_REPOSITORY_URL=
NEXT_PUBLIC_GEOVISTA_LIVE_URL=
NEXT_PUBLIC_AGROZYRO_REPOSITORY_URL=
NEXT_PUBLIC_AGROZYRO_LIVE_URL=

# ProjectShowcase uses images/covers and external links, not iframe embeds.
# Old NEXT_PUBLIC_*_EMBED_ENABLED values are no longer used.
